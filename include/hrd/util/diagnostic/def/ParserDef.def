//============================================================
// HRD_P001
//
// Trigger:
//   An access modifier is applied to a declaration other than
//   a field variable.
//============================================================
DIAG(HRD_P001,
     Error,
     "access modifier is not allowed here",
     "HRD-P001")

//============================================================
// HRD_P002
//
// Trigger:
//   The 'const' modifier is specified more than once on the
//   same declaration.
//============================================================
DIAG(HRD_P002,
     Error,
     "duplicate 'const' modifier",
     "HRD-P002")

//============================================================
// HRD_P003
//
// Trigger:
//   The 'root' modifier is specified more than once on the
//   same declaration.
//============================================================
DIAG(HRD_P003,
     Error,
     "duplicate 'root' modifier",
     "HRD-P003")

//============================================================
// HRD_P004
//
// Trigger:
//   The 'frame' modifier is specified more than once on the
//   same declaration.
//============================================================
DIAG(HRD_P004,
     Error,
     "duplicate 'frame' modifier",
     "HRD-P004")

//============================================================
// HRD_P005
//
// Trigger:
//   The 'override' modifier is specified more than once on the
//   same declaration.
//============================================================
DIAG(HRD_P005,
     Error,
     "duplicate 'override' modifier",
     "HRD-P005")

//============================================================
// HRD_P006
//
// Trigger:
//   The 'async' modifier is specified more than once on the
//   same declaration.
//============================================================
DIAG(HRD_P006,
     Error,
     "duplicate 'async' modifier",
     "HRD-P006")

//============================================================
// HRD_P007
//
// Trigger:
//   A statement or expression appears at the top level where
//   only declarations are permitted.
//============================================================
DIAG(HRD_P007,
     Error,
     "only declarations are allowed at top level",
     "HRD-P007")

//============================================================
// HRD_P008
//
// Trigger:
//   More than one access modifier is specified on the same
//   declaration.
//============================================================
DIAG(HRD_P008,
     Error,
     "duplicate access modifier",
     "HRD-P008")

//============================================================
// HRD_P009
//
// Trigger:
//   A type declaration is placed inside a scope where only
//   top-level declarations are allowed.
//============================================================
DIAG(HRD_P009,
     Error,
     "type declarations are only allowed at top level",
     "HRD-P009")
    
//============================================================
// HRD_P010
//
// Trigger:
//   A declaration other than a field or init declaration
//   appears inside a struct body.
//============================================================
DIAG(HRD_P010,
     Error,
     "only field and init declarations are allowed in struct bodies",
     "HRD-P010")

//============================================================
// HRD_P011
//
// Trigger:
//   A declaration other than a field or method declaration
//   appears inside a class body.
//============================================================
DIAG(HRD_P011,
     Error,
     "only field and method declarations are allowed in class bodies",
     "HRD-P011")

//============================================================
// HRD_P012
//
// Trigger:
//   A method declaration appears inside a block scope where
//   only statements and local declarations are allowed.
//============================================================
DIAG(HRD_P012,
     Error,
     "method declarations are not allowed in block scopes",
     "HRD-P012")

//============================================================
// HRD_P013
//
// Trigger:
//   A comma in a parameter list is not followed by a valid
//   parameter declaration.
//============================================================
DIAG(HRD_P013,
     Error,
     "expected parameter declaration after ','",
     "HRD-P013")

//============================================================
// HRD_P014
//
// Trigger:
//   A parameter name appears before a valid parameter type
//   in a parameter declaration.
//============================================================
DIAG(HRD_P014,
     Error,
     "expected parameter type before parameter name",
     "HRD-P014")

//============================================================
// HRD_P015
//
// Trigger:
//   The 'const' modifier is applied to a declaration other
//   than a variable declaration.
//============================================================
DIAG(HRD_P015,
     Error,
     "'const' is only allowed on variable declarations",
     "HRD-P015")

//============================================================
// HRD_P016
//
// Trigger:
//   The 'root' modifier is applied to a declaration other
//   than a variable declaration.
//============================================================
DIAG(HRD_P016,
     Error,
     "'root' is only allowed on variable declarations",
     "HRD-P016")

//============================================================
// HRD_P017
//
// Trigger:
//   A declaration other than a method declaration appears
//   inside an impl block.
//============================================================
DIAG(HRD_P017,
     Error,
     "only method declarations are allowed in impl bodies",
     "HRD-P017")

//============================================================
// HRD_P018
//
// Trigger:
//   An access modifier appears on a trait method signature.
//============================================================
DIAG(HRD_P018,
     Error,
     "access modifiers are not allowed in trait method signatures",
     "HRD-P018")

//============================================================
// HRD_P019
//
// Trigger:
//   A declaration other than a method signature appears
//   inside a trait body.
//============================================================
DIAG(HRD_P019,
     Error,
     "only method signatures are allowed in trait bodies",
     "HRD-P019")

//============================================================
// HRD_P020
//
// Trigger:
//   An enum variant payload declaration does not contain a
//   valid type name.
//============================================================
DIAG(HRD_P020,
     Error,
     "expected type name in enum variant payload",
     "HRD-P020")

//============================================================
// HRD_P021
//
// Trigger:
//   A generic type argument list contains '<' without a
//   valid type argument.
//============================================================
DIAG(HRD_P021,
     Error,
     "expected type name after '<'",
     "HRD-P021")
     
//============================================================
// HRD_P022
//
// Trigger:
//   An init method is invoked explicitly instead of being
//   called automatically during initialization.
//============================================================
DIAG(HRD_P022,
     Error,
     "init methods cannot be called directly",
     "HRD-P022")

//============================================================
// HRD_P023
//
// Trigger:
//   An init method is declared without public access.
//============================================================
DIAG(HRD_P023,
     Error,
     "init methods must be public",
     "HRD-P023")

//============================================================
// HRD_P024
//
// Trigger:
//   An onDestroy method is invoked explicitly instead of being
//   called automatically during entity destruction.
//============================================================
DIAG(HRD_P024,
     Error,
     "onDestroy methods cannot be called directly",
     "HRD-P024")

//============================================================
// HRD_P025
//
// Trigger:
//   An onDestroy method is declared without public access.
//============================================================
DIAG(HRD_P025,
     Error,
     "onDestroy methods must be public",
     "HRD-P025")

//============================================================
// HRD_P026
//
// Trigger:
//   An access modifier is not followed by a valid type name.
//============================================================
DIAG(HRD_P026,
     Error,
     "expected type name after access modifier",
     "HRD-P026")

//============================================================
// HRD_P027
//
// Trigger:
//   A ':' type suffix is used on a non-built-in type.
//============================================================
DIAG(HRD_P027,
     Error,
     "':' is only allowed on built-in types",
     "HRD-P027")

//============================================================
// HRD_P028
//
// Trigger:
//   A built-in type is used with an incompatible type width
//   specifier.
//============================================================
DIAG(HRD_P028,
     Error,
     "type width specifier does not match built-in type",
     "HRD-P028")

//============================================================
// HRD_P029
//
// Trigger:
//   The 'frame' modifier is used on a declaration that is not
//   a function.
//============================================================
DIAG(HRD_P029,
     Error,
     "'frame' is only allowed on method declarations",
     "HRD-P029")

//============================================================
// HRD_P030
//
// Trigger:
//   The 'override' modifier is used on a declaration that is not
//   a function.
//============================================================
DIAG(HRD_P030,
     Error,
     "'override' is only allowed on method declarations",
     "HRD-P030")

//============================================================
// HRD_P031
//
// Trigger:
//   The 'async' modifier is used on a declaration that is not
//   a function.
//============================================================
DIAG(HRD_P031,
     Error,
     "'async' is only allowed on method declarations",
     "HRD-P031")

//============================================================
// HRD_P032
//
// Trigger:
//   A payload case selector does not bind exactly one variable.
//============================================================
DIAG(HRD_P032,
     Error,
     "payload case selectors must bind one variable",
     "HRD-P032")

//============================================================
// HRD_P033
//
// Trigger:
//   An assignment target is not an assignable expression.
//============================================================
DIAG(HRD_P033,
     Error,
     "expression is not assignable",
     "HRD-P033")

//============================================================
// HRD_P034
//
// Trigger:
//   An expression that is not a callable value is invoked with
//   a function call.
//============================================================
DIAG(HRD_P034,
     Error,
     "expression is not callable",
     "HRD-P034")

//============================================================
// HRD_P035
//
// Trigger:
//   An expression was expected, but another token or construct
//   was found instead.
//============================================================
DIAG(HRD_P035,
     Error,
     "expected expression",
     "HRD-P035")

//============================================================
// HRD_P036
//
// Trigger:
//   A variable declaration in a for-loop introduces an
//   initializer.
//============================================================
DIAG(HRD_P036,
     Error,
     "for-loop variable declarations cannot have initializers",
     "HRD-P036")

//============================================================
// HRD_P037
//
// Trigger:
//   A ',' is followed by something other than a case selector.
//============================================================
DIAG(HRD_P037,
     Error,
     "expected case selector after ','",
     "HRD-P037")

//============================================================
// HRD_P038
//
// Trigger:
//   A declaration other than 'case' or 'default' appears
//   directly inside a switch body.
//============================================================
DIAG(HRD_P038,
     Error,
     "only 'case' and 'default' declarations are allowed in switch bodies",
     "HRD-P038")

//============================================================
// HRD_P039
//
// Trigger:
//   A declaration other than 'case' or a wildcard selector
//   appears directly inside a match expression.
//============================================================
DIAG(HRD_P039,
     Error,
     "only 'case' declarations and wildcard selectors are allowed in match expressions",
     "HRD-P039")

//============================================================
// HRD_P040
//
// Trigger:
//   A body is not terminated with a closing '}'.
//============================================================
DIAG(HRD_P040,
     Error,
     "expected '}'",
     "HRD-P040")

//============================================================
// HRD_P041
//
// Trigger:
//   A type declaration keyword is not followed by a type name.
//============================================================
DIAG(HRD_P041,
     Error,
     "expected type name",
     "HRD-P041")

//============================================================
// HRD_P042
//
// Trigger:
//   A method declaration is missing its name.
//============================================================
DIAG(HRD_P042,
     Error,
     "expected method name",
     "HRD-P042")

//============================================================
// HRD_P043
//
// Trigger:
//   A '{' was expected but another token was found.
//============================================================
DIAG(HRD_P043,
     Error,
     "expected '{'",
     "HRD-P043")

//============================================================
// HRD_P044
//
// Trigger:
//   A ';' was expected but another token was found.
//============================================================
DIAG(HRD_P044,
     Error,
     "expected ';'",
     "HRD-P044")

//============================================================
// HRD_P045
//
// Trigger:
//   A variable declaration is missing its name.
//============================================================
DIAG(HRD_P045,
     Error,
     "expected variable name",
     "HRD-P045")

//============================================================
// HRD_P046
//
// Trigger:
//   A '(' was expected but another token was found.
//============================================================
DIAG(HRD_P046,
     Error,
     "expected '('",
     "HRD-P046")

//============================================================
// HRD_P047
//
// Trigger:
//   A ')' was expected but another token was found.
//============================================================
DIAG(HRD_P047,
     Error,
     "expected ')'",
     "HRD-P047")

//============================================================
// HRD_P048
//
// Trigger:
//   An enum variant declaration is missing its name.
//============================================================
DIAG(HRD_P048,
     Error,
     "expected enum variant name",
     "HRD-P048")

//============================================================
// HRD_P049
//
// Trigger:
//   A '<' was expected but another token was found.
//============================================================
DIAG(HRD_P049,
     Error,
     "expected '<'",
     "HRD-P049")

//============================================================
// HRD_P050
//
// Trigger:
//   A '>' was expected but another token was found.
//============================================================
DIAG(HRD_P050,
     Error,
     "expected '>'",
     "HRD-P050")

//============================================================
// HRD_P051
//
// Trigger:
//   A ':' was expected but another token was found.
//============================================================
DIAG(HRD_P051,
     Error,
     "expected ':'",
     "HRD-P051")

//============================================================
// HRD_P052
//
// Trigger:
//   A '[' was expected but another token was found.
//============================================================
DIAG(HRD_P052,
     Error,
     "expected '['",
     "HRD-P052")

//============================================================
// HRD_P053
//
// Trigger:
//   A ']' was expected but another token was found.
//============================================================
DIAG(HRD_P053,
     Error,
     "expected ']'",
     "HRD-P053")

//============================================================
// HRD_P054
//
// Trigger:
//   A member access operator is followed by a token that is
//   not a valid member name.
//============================================================
DIAG(HRD_P054,
     Error,
     "expected member name after '.'",
     "HRD-P054")

//============================================================
// HRD_P055
//
// Trigger:
//   A range expression is missing the '..' operator.
//============================================================
DIAG(HRD_P055,
     Error,
     "expected '..' in range expression",
     "HRD-P055")

//============================================================
// HRD_P056
//
// Trigger:
//   A case arm is missing the '=>' separator.
//============================================================
DIAG(HRD_P056,
     Error,
     "expected '=>' in case arm",
     "HRD-P056")

//============================================================
// HRD_P057
//
// Trigger:
//   A built-in type is followed by ':' but no valid type
//   width specifier.
//============================================================
DIAG(HRD_P057,
     Error,
     "expected type width specifier",
     "HRD-P057")
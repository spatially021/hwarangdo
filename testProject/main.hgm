class Main{
    Handle<Player> player;
    int dx=1;

    frame void update(){
        Player p=world.view(player);
        p.move(dx,_);
        int moveKind = match(p.state){
            case Idle => {<<-1;}
            case Act(k) => {<<k;}
        };
    }

    public init(){
        player=world.spawn Player();
    }

}


trait moveable{
    void move(int dx,int dy);
}

struct Vec{
    int x=0;
    int y=0;
}

class Player : moveable{
    Vec pos;
    State state;

    void move(int dx = 0,int dy = 0){
        pos.x+=dx;
        pos.y+=dy;
        if(dx==0 && dy==0){
            state=State.Idle;
        }else{
            state=State.Act(0);
        }
    }

    public init(){
    }
}

enum State{
    Idle,
    Act(int)
}
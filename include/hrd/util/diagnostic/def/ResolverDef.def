//============================================================
// HRD_S019
//
// Trigger:
//   A protected method is accessed from a context where it is
//   not accessible.
//============================================================
DIAG(HRD_S019,
     Error,
     "cannot access protected method in this context",
     "HRD-S019")

//============================================================
// HRD_S020
//
// Trigger:
//   A private method is accessed from outside the type that
//   declares it.
//============================================================
DIAG(HRD_S020,
     Error,
     "cannot access private method in this context",
     "HRD-S020")

//============================================================
// HRD_S021
//
// Trigger:
//   No init declaration matches the provided arguments.
//============================================================
DIAG(HRD_S021,
     Error,
     "no matching init declaration found",
     "HRD-S021")

//============================================================
// HRD_S022
//
// Trigger:
//   An enum variant declares more than one payload.
//============================================================
DIAG(HRD_S022,
     Error,
     "enum variants can have at most one payload",
     "HRD-S022")

//============================================================
// HRD_S023
//
// Trigger:
//   A payload is provided for an enum variant that does not
//   declare one.
//============================================================
DIAG(HRD_S023,
     Error,
     "this variant does not have a payload",
     "HRD-S023")

//============================================================
// HRD_S024
//
// Trigger:
//   The payload type does not match the type declared by the
//   enum variant.
//============================================================
DIAG(HRD_S024,
     Error,
     "payload type does not match",
     "HRD-S024")

//============================================================
// HRD_S025
//
// Trigger:
//   An enum variant that declares a payload is constructed
//   without providing one.
//============================================================
DIAG(HRD_S025,
     Error,
     "this variant requires a payload",
     "HRD-S025")

//============================================================
// HRD_S026
//
// Trigger:
//   A call refers to a runtime function that is not recognized
//   by the compiler.
//============================================================
DIAG(HRD_S026,
     Error,
     "unknown runtime method",
     "HRD-S026")

//============================================================
// HRD_S027
//
// Trigger:
//   A method call refers to a method that is not declared
//   for the target type.
//============================================================
DIAG(HRD_S027,
     Error,
     "unknown method",
     "HRD-S027")

//============================================================
// HRD_S028
//
// Trigger:
//   A reference refers to an enum variant that is not declared
//   in the target enum.
//============================================================
DIAG(HRD_S028,
     Error,
     "unknown enum variant",
     "HRD-S028")

//============================================================
// HRD_S029
//
// Trigger:
//   A static method declaration or call is encountered,
//   but static methods are not supported yet.
//============================================================
DIAG(HRD_S029,
     Error,
     "static method is not supported yet",
     "HRD-S029")

//============================================================
// HRD_S030
//
// Trigger:
//   A member of a handle type is accessed directly instead of
//   accessing the underlying object.
//============================================================
DIAG(HRD_S030,
     Error,
     "cannot access member of handle type",
     "HRD-S030")

//============================================================
// HRD_S031
//
// Trigger:
//   A method call resolves to one or more methods with the
//   requested name, but none match the provided arguments.
//============================================================
DIAG(HRD_S031,
     Error,
     "no matching method found",
     "HRD-S031")

//============================================================
// HRD_S032
//
// Trigger:
//   A method call resolves to multiple equally viable
//   overloads, making the call ambiguous.
//============================================================
DIAG(HRD_S032,
     Error,
     "ambiguous method call",
     "HRD-S032")

//============================================================
// HRD_S033
//
// Trigger:
//   A floating-point literal cannot be represented by any
//   supported floating-point type.
//============================================================
DIAG(HRD_S033,
     Error,
     "floating-point literal out of range",
     "HRD-S033")

//============================================================
// HRD_S034
//
// Trigger:
//   A type is used where a trait implementation is required,
//   but the type does not implement that trait.
//============================================================
DIAG(HRD_S034,
     Error,
     "not implement trait",
     "HRD-S034")

//============================================================
// HRD_S035
//
// Trigger:
//   A trait implementation block declares a method that is
//   not required by any trait implemented by the block.
//============================================================
DIAG(HRD_S035,
     Error,
     "invalid method in trait implementation",
     "HRD-S035")

//============================================================
// HRD_S036
//
// Trigger:
//   A return expression has a type that cannot be converted
//   to the method's declared return type.
//============================================================
DIAG(HRD_S036,
     Error,
     "return type mismatch",
     "HRD-S036")

//============================================================
// HRD_S037
//
// Trigger:
//   A method marked override does not match any overridable
//   method declared by the parent type.
//============================================================
DIAG(HRD_S037,
     Error,
     "unknown override target",
     "HRD-S037")

//============================================================
// HRD_S038
//
// Trigger:
//   A method matches an inherited method declaration but is
//   not marked with the override modifier.
//============================================================
DIAG(HRD_S038,
     Error,
     "missing override modifier",
     "HRD-S038")

//============================================================
// HRD_S039
//
// Trigger:
//   A method is marked with the override modifier in a class
//   that does not inherit from another class.
//============================================================
DIAG(HRD_S039,
     Error,
     "override in non-inherited class",
     "HRD-S039")

//============================================================
// HRD_S040
//
// Trigger:
//   A method marked frame does not satisfy the declaration
//   requirements for a frame method.
//============================================================
DIAG(HRD_S040,
     Error,
     "invalid frame method",
     "HRD-S040")

//============================================================
// HRD_S041
//
// Trigger:
//   An observer variable is initialized with an expression
//   other than a world.view result.
//============================================================
DIAG(HRD_S041,
     Error,
     "invalid observer initialization",
     "HRD-S041")

//============================================================
// HRD_S042
//
// Trigger:
//   A field is initialized with an expression that is not
//   permitted for the field's declared type.
//============================================================
DIAG(HRD_S042,
     Error,
     "invalid field initializer",
     "HRD-S042")

//============================================================
// HRD_S043
//
// Trigger:
//   An observer variable is declared without an initializer.
//============================================================
DIAG(HRD_S043,
     Error,
     "uninitialized observer",
     "HRD-S043")

//============================================================
// HRD_S044
//
// Trigger:
//   A field is declared with an entity type, which represents
//   an observer rather than a storable value.
//============================================================
DIAG(HRD_S044,
     Error,
     "observer field not allowed",
     "HRD-S044")

//============================================================
// HRD_S045
//
// Trigger:
//   A parameter's default argument has a type that cannot be
//   converted to the parameter's declared type.
//============================================================
DIAG(HRD_S045,
     Error,
     "default argument type mismatch",
     "HRD-S045")

//============================================================
// HRD_S046
//
// Trigger:
//   An init declaration specifies an explicit return type.
//============================================================
DIAG(HRD_S046,
     Error,
     "return type not allowed on init",
     "HRD-S046")

//============================================================
// HRD_S047
//
// Trigger:
//   An onDestroy declaration specifies an explicit return
//   type.
//============================================================
DIAG(HRD_S047,
     Error,
     "return type not allowed on onDestroy",
     "HRD-S047")

//============================================================
// HRD_S048
//
// Trigger:
//   An array access expression uses an index whose type is
//   not an integer type.
//============================================================
DIAG(HRD_S048,
     Error,
     "invalid array index type",
     "HRD-S048")

//============================================================
// HRD_S049
//
// Trigger:
//   An array access expression is applied to a value whose
//   type is not an array type.
//============================================================
DIAG(HRD_S049,
     Error,
     "subscript on non-array type",
     "HRD-S049")

//============================================================
// HRD_S050
//
// Trigger:
//   A 'this' expression appears outside a class method
//   context.
//============================================================
DIAG(HRD_S050,
     Error,
     "'this' outside class context",
     "HRD-S050")

//============================================================
// HRD_S051
//
// Trigger:
//   A 'super' expression appears outside a class method
//   context.
//============================================================
DIAG(HRD_S051,
     Error,
     "'super' outside class context",
     "HRD-S051")

//============================================================
// HRD_S052
//
// Trigger:
//   A 'super' expression appears in a class that does not
//   inherit from another class.
//===========================================================
DIAG(HRD_S052,
     Error,
     "'super' in non-inherited class",
     "HRD-S052")

//============================================================
// HRD_S053
//
// Trigger:
//   A 'self' expression appears outside an impl method
//   context.
//============================================================
DIAG(HRD_S053,
     Error,
     "'self' outside impl context",
     "HRD-S053")

//============================================================
// HRD_S054
//
// Trigger:
//   A range expression uses bounds whose type is not a
//   currently supported integer type.
//============================================================
DIAG(HRD_S054,
     Error,
     "unsupported range type",
     "HRD-S054")

//============================================================
// HRD_S055
//
// Trigger:
//   A for-range expression specifies a step value whose type
//   is not an integer type.
//============================================================
DIAG(HRD_S055,
     Error,
     "invalid range step type",
     "HRD-S055")

//============================================================
// HRD_S056
//
// Trigger:
//   A switch or match expression declares the same case value
//   more than once.
//============================================================
DIAG(HRD_S056,
     Error,
     "duplicate case value",
     "HRD-S056")

DIAG(HRD_S057,
     Error,
     "enum target required",
     "HRD-S057")

DIAG(HRD_S058,
     Error,
     "enum type mismatch",
     "HRD-S058")

DIAG(HRD_S059,
     Error,
     "invalid case value",
     "HRD-S059")

DIAG(HRD_S060,
     Error,
     "duplicate variable declaration",
     "HRD-S060")

DIAG(HRD_S061,
     Error,
     "invalid payload binding",
     "HRD-S061")

DIAG(HRD_S062,
     Error,
     "inconsistent match result type",
     "HRD-S062")

DIAG(HRD_S063,
     Error,
     "wildcard case must be last",
     "HRD-S063")

DIAG(HRD_S064,
     Error,
     "non-exhaustive match",
     "HRD-S064")

DIAG(HRD_S065,
     Error,
     "invalid match target",
     "HRD-S065")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A unary operator is applied to an operand type that does not support that
// operator.
//=============================================================================
DIAG(HRD_S066,
     Error,
     "invalid unary operand",
     "HRD-S066")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// Unary operator '-' is applied to an unsigned numeric operand.
//=============================================================================
DIAG(HRD_S067,
     Error,
     "unsigned value cannot be negated",
     "HRD-S067")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A binary operator is applied to operand types for which no valid operation
// is defined.
//=============================================================================
DIAG(HRD_S068,
     Error,
     "invalid binary operands",
     "HRD-S068")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A binary operation requires an implicit numeric conversion that may lose
// precision.
//=============================================================================
DIAG(HRD_S069,
     Warning,
     "implicit conversion may lose precision",
     "HRD-S069")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// The condition expression of a ternary expression does not have type bool.
//=============================================================================
DIAG(HRD_S070,
     Error,
     "ternary condition must be boolean",
     "HRD-S070")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// The then and else expressions of a ternary expression cannot be converted
// to compatible result types.
//=============================================================================
DIAG(HRD_S071,
     Error,
     "incompatible ternary branch types",
     "HRD-S071")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A non-enum type name is used in a value expression.
//=============================================================================
DIAG(HRD_S072,
     Error,
     "type cannot be used as a value",
     "HRD-S072")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A name expression does not resolve to a variable in the current context,
// an inherited member, or an enum type.
//=============================================================================
DIAG(HRD_S073,
     Error,
     "undeclared variable",
     "HRD-S073")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// The value on the right side of an assignment cannot be implicitly converted
// to the type of the assignment target.
//=============================================================================
DIAG(HRD_S074,
     Error,
     "assignment type mismatch",
     "HRD-S074")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// An assignment targets a variable whose type represents an entity observer.
//=============================================================================
DIAG(HRD_S075,
     Error,
     "observer reassignment is not allowed",
     "HRD-S075")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// Member lookup fails for the resolved type of a member access expression,
// including all inherited member scopes.
//=============================================================================
DIAG(HRD_S076,
     Error,
     "unknown member",
     "HRD-S076")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// The condition expression of an if or while statement does not have type
// bool.
//=============================================================================
DIAG(HRD_S077,
     Error,
     "condition must be boolean",
     "HRD-S077")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// Values produced by a for-range cannot be assigned to the declared type of
// the loop variable.
//=============================================================================
DIAG(HRD_S078,
     Error,
     "incompatible range variable type",
     "HRD-S078")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A default case is followed by another case in the same switch statement.
//=============================================================================
DIAG(HRD_S079,
     Error,
     "default case must be last",
     "HRD-S079")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A wildcard case is declared in a switch statement.
//=============================================================================
DIAG(HRD_S080,
     Error,
     "wildcard case is not allowed in switch",
     "HRD-S080")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A switch statement does not handle every possible target value and does not
// contain a default case.
//=============================================================================
DIAG(HRD_S081,
     Error,
     "non-exhaustive switch",
     "HRD-S081")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// The target expression of a switch statement has a type other than a
// primitive or enum type.
//=============================================================================
DIAG(HRD_S082,
     Error,
     "invalid switch target",
     "HRD-S082")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A switch case declares multiple selector values while one of the selectors
// binds an enum payload.
//=============================================================================
DIAG(HRD_S083,
     Error,
     "payload case must have one value",
     "HRD-S083")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A case belonging to a match expression contains no value transfer
// statement.
//=============================================================================
DIAG(HRD_S084,
     Error,
     "match case must transfer a value",
     "HRD-S084")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// Value transfer statements within the same match case produce incompatible
// types.
//=============================================================================
DIAG(HRD_S085,
     Error,
     "inconsistent value transfer type",
     "HRD-S085")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A case belonging to a match expression declares more than one selector
// value.
//=============================================================================
DIAG(HRD_S086,
     Error,
     "match case must have one value",
     "HRD-S086")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A return statement is declared within an init method.
//=============================================================================
DIAG(HRD_S087,
     Error,
     "return is not allowed in init",
     "HRD-S087")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A value transfer statement is declared outside a match case, including
// inside a switch case.
//=============================================================================
DIAG(HRD_S088,
     Error,
     "value transfer outside match case",
     "HRD-S088")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// Literal-based primitive type inference is requested for a declared type that
// is not a primitive type.
//=============================================================================
DIAG(HRD_S089,
     Error,
     "invalid literal inference target",
     "HRD-S089")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// An integer literal requires more precision than any supported floating-point
// type can provide.
//=============================================================================
DIAG(HRD_S090,
     Error,
     "floating-point literal range is not supported",
     "HRD-S090")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A primitive declaration cannot infer a concrete type from the initializer's
// type or the declared primitive category does not support inference.
//=============================================================================
DIAG(HRD_S091,
     Error,
     "primitive type inference failed",
     "HRD-S091")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A conversion result cannot be represented within the target type's maximum
// range.
//=============================================================================
DIAG(HRD_S092,
     Error,
     "conversion overflow",
     "HRD-S092")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A conversion result is smaller in magnitude than the target type can
// represent.
//=============================================================================
DIAG(HRD_S093,
     Error,
     "conversion underflow",
     "HRD-S093")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// An implicit conversion is requested from a signed integer type to an
// unsigned integer type.
//=============================================================================
DIAG(HRD_S094,
     Error,
     "signed-to-unsigned conversion is not allowed",
     "HRD-S094")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A negative integer literal is converted to an unsigned integer type.
//=============================================================================
DIAG(HRD_S095,
     Error,
     "negative value cannot be unsigned",
     "HRD-S095")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A conversion cannot preserve the full precision of the source value in the
// target type.
//=============================================================================
DIAG(HRD_S096,
     Error,
     "conversion loses precision",
     "HRD-S096")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A floating-point conversion cannot preserve the source value's fractional
// representation exactly.
//=============================================================================
DIAG(HRD_S097,
     Error,
     "conversion loses fractional precision",
     "HRD-S097")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// No valid implicit conversion exists between the source and target types, or
// the source value belongs to an incompatible type category.
//=============================================================================
DIAG(HRD_S098,
     Error,
     "invalid implicit conversion",
     "HRD-S098")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A valid conversion exists, but the conversion cannot be performed
// implicitly.
//=============================================================================
DIAG(HRD_S099,
     Error,
     "explicit cast required",
     "HRD-S099")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A conversion targets a type with a narrower representation than the source
// type.
//=============================================================================
DIAG(HRD_S100,
     Error,
     "unsafe narrowing conversion",
     "HRD-S100")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A conversion encounters a NaN value that is not accepted by the target
// representation.
//=============================================================================
DIAG(HRD_S101,
     Error,
     "NaN cannot be converted",
     "HRD-S101")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A conversion encounters an infinite value that cannot be represented by the
// target type.
//=============================================================================
DIAG(HRD_S102,
     Error,
     "infinite value cannot be converted",
     "HRD-S102")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A conversion is requested for a source and target type combination whose
// conversion behavior has not been implemented.
//=============================================================================
DIAG(HRD_S103,
     Error,
     "conversion is not supported",
     "HRD-S103")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// The receiver of a spawn expression is not a builtin entity storage
// expression.
//=============================================================================
DIAG(HRD_S104,
     Error,
     "invalid spawn storage",
     "HRD-S104")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// The target type of a spawn expression is not a class entity type.
//=============================================================================
DIAG(HRD_S105,
     Error,
     "spawn target must be an entity",
     "HRD-S105")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// The target expression of world.view or world.destroy does not have a
// Handle<T> type.
//=============================================================================
DIAG(HRD_S106,
     Error,
     "handle required",
     "HRD-S106")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// The target of world.view or world.destroy has a Handle<T> type, but its
// expression form cannot provide a valid handle storage location.
//=============================================================================
DIAG(HRD_S107,
     Error,
     "invalid handle expression",
     "HRD-S107")

//=============================================================================
// Trigger
//-----------------------------------------------------------------------------
// A quit expression is declared within an init method.
//=============================================================================
DIAG(HRD_S108,
     Error,
     "quit is not allowed in init",
     "HRD-S108")
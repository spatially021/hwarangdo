////////////////////////////////////////////////////////////
// Trait 정의
////////////////////////////////////////////////////////////

trait Movable {
    func move(int dx, int dy);
}

trait Drawable {
    func draw();
}

////////////////////////////////////////////////////////////
// Struct
////////////////////////////////////////////////////////////

struct Vec2 {
    int x;
    int y;
}

////////////////////////////////////////////////////////////
// Enum
////////////////////////////////////////////////////////////

enum State {
    Idle,
    Moving(int),
    Dead
}

////////////////////////////////////////////////////////////
// Base Class
////////////////////////////////////////////////////////////

class Entity {
    int id;

    func update() {
        id = id + 1;
    }
}

////////////////////////////////////////////////////////////
// Trait 다중 상속 클래스
////////////////////////////////////////////////////////////

class Player : Movable Drawable {

    Vec2 position;
    State state;

    func move(int dx, int dy) {
        position.x = position.x + dx;
        position.y = position.y + dy;
        state = State.Moving(1);
    }

    func draw() {
        position.x = position.x + 1;
    }
}

////////////////////////////////////////////////////////////
// 단일 상속
////////////////////////////////////////////////////////////

class Actor extends Entity {
    int id;
    func update() {
        id = id + 2;
    }
}

////////////////////////////////////////////////////////////
// extends + trait 다중 상속
////////////////////////////////////////////////////////////

class NPC extends Actor : Movable {

    Vec2 pos;

    func move(int dx, int dy) {
        pos.x = pos.x + dx;
        pos.y = pos.y + dy;
    }

    func update() {
        id = id + 3;
    }
}

////////////////////////////////////////////////////////////
// trait 상속 확인용 클래스
////////////////////////////////////////////////////////////

class Enemy : Movable {

    func move(int dx, int dy) {
        int temp = dx + dy;
    }
}
